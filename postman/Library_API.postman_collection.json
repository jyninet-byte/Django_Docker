{
  "info": {
    "name": "Library REST API",
    "description": "CRUD for /api/v1/user, /api/v1/user/{id}/order, /api/v1/order, /api/v1/book, /api/v1/author.\nRun `python manage.py seed_library` first. Default auth: librarian (Basic Auth).\nRun the whole collection with the Collection Runner - every request checks its status code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{librarian_email}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{librarian_password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const day = 24 * 60 * 60 * 1000;",
          "pm.collectionVariables.set(\"now_date\", new Date().toISOString());",
          "pm.collectionVariables.set(\"future_date\", new Date(Date.now() + 14 * day).toISOString());",
          "pm.collectionVariables.set(\"later_date\", new Date(Date.now() + 21 * day).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "librarian_email",
      "value": "librarian@library.com"
    },
    {
      "key": "librarian_password",
      "value": "librarian123"
    },
    {
      "key": "reader_email",
      "value": "reader@library.com"
    },
    {
      "key": "reader_password",
      "value": "reader123"
    },
    {
      "key": "book_id",
      "value": ""
    },
    {
      "key": "author_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "user_order_id",
      "value": ""
    }
  ],
